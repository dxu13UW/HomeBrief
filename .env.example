# Friendly name of the Google Home speaker as shown in the Google Home app
SPEAKER_NAME=Living Room speaker
# Optional: speaker IP, skips mDNS discovery (useful under WSL)
SPEAKER_IP=
# Port for the local HTTP server that serves speech audio to the speaker
HTTP_PORT=8765
# IANA time zone
TIME_ZONE=America/Los_Angeles
# Daily briefing time (24h HH:MM)
BRIEFING_TIME=07:30
# Google Calendar to read and write ("primary" = your main calendar)
CALENDAR_ID=primary
