# Friendly name of the Google Home speaker as shown in the Google Home app
SPEAKER_NAME=Living Room speaker
# Optional: speaker IP, skips mDNS discovery (useful under WSL)
SPEAKER_IP=
# Port for the local HTTP server that serves speech audio to the speaker
HTTP_PORT=8765
# IANA time zone
TIME_ZONE=America/Los_Angeles
# Daily briefing time (24h HH:MM)
BRIEFING_TIME=07:30
# Google Calendar to read and write ("primary" = your main calendar)
CALENDAR_ID=primary
# Stop hook: only announce Claude Code turns that took at least this many seconds
HOOK_MIN_SECONDS=60
# Discord Rich Presence for focus blocks: Application ID from discord.com/developers (not a secret)
DISCORD_CLIENT_ID=
# Set to 1 on the one machine that runs the scheduled briefing, Discord presence and Stop hook;
# leave empty everywhere else so two machines never both speak or post
HOMEBRIEF_SCHEDULER=
